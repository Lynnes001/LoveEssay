# Web API 监听端口
PORT=6789

# Docker Nginx 对外暴露的宿主机端口
HOST_PORT=6788

# Web 服务基础地址（本地开发默认直连 6789；Docker 部署时通常改成 http://127.0.0.1:${HOST_PORT}）
PUBLIC_BASE_URL=http://127.0.0.1:6789

# DashScope 兼容模式 API Key（必填）
DASHSCOPE_API_KEY=your-dashscope-api-key

# 应用登录页账号密码（部署环境建议修改默认值）
APP_LOGIN_USER=admin
APP_LOGIN_PASS=change-me
AUTH_SESSION_SECRET=change-session-secret
AUTH_SESSION_TTL_SECONDS=604800
# 反向代理已启用 HTTPS 时再打开
AUTH_SECURE_COOKIE=false

# LangSmith tracing（可选）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=loveessay
# 如果使用自建或 EU 区域 LangSmith，再设置：
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=your-workspace-id

# DashScope OpenAI 兼容模式基础地址
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 各阶段模型，可按需替换
# 第一个模型链路默认走 DashScope API 的 Qwen3.5-Plus
EXTRACT_MODEL=qwen3.5-plus
DRAFT_MODEL=qwen3.5-plus
CHECK_MODEL=qwen3.5-plus

# 第二个模型默认走你在阿里云部署的模型
REWRITE_MODEL=qwen3-14b-81bba393c391

# 上传与任务限制
MAX_UPLOAD_SIZE_MB=15
RATE_LIMIT_PER_MINUTE=30
TASK_TIMEOUT_MS=900000
TASK_TTL_MS=172800000

# 存储与任务基础设施
UPLOAD_DIR=./uploads
DATABASE_URL=postgresql://loveessay:loveessay@127.0.0.1:5432/loveessay
REDIS_URL=redis://127.0.0.1:6379
QUEUE_NAME=loveessay-tasks

# Docker Compose 中 postgres 服务的初始化凭据
POSTGRES_DB=loveessay
POSTGRES_USER=loveessay
POSTGRES_PASSWORD=change-db-password

# 基础镜像，可替换为 ACR 等可访问镜像地址
DOCKER_PLATFORM=
NODE_BASE_IMAGE=node:20-bookworm-slim
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7
NGINX_IMAGE=nginx:1.27-alpine

# pgAdmin 网页后台，默认走阿里云 ACR，避免 ECS 直连 Docker Hub 超时
PGADMIN_IMAGE=crpi-n8xq04c9r8533fv2.cn-chengdu.personal.cr.aliyuncs.com/sid729/pgadmin:latest
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-pgadmin-password
