# Web API 监听端口（需与 nginx proxy_pass web:8000 一致）
PORT=8000

# Web 服务基础地址（用于结果页跳转和反向代理场景）
PUBLIC_BASE_URL=http://127.0.0.1:8000

# DashScope 兼容模式 API Key（必填）
DASHSCOPE_API_KEY=your-dashscope-api-key

# DashScope OpenAI 兼容模式基础地址
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 各阶段模型，可按需替换
# 第一个模型链路默认走 DashScope API 的 Qwen3.5-Plus
EXTRACT_MODEL=qwen3.5-plus
DRAFT_MODEL=qwen3.5-plus
CHECK_MODEL=qwen3.5-plus

# 第二个模型默认走你在阿里云部署的模型
REWRITE_MODEL=your-custom-deployed-model-name

# 上传与任务限制
MAX_UPLOAD_SIZE_MB=15
RATE_LIMIT_PER_MINUTE=30
TASK_TIMEOUT_MS=900000
TASK_TTL_MS=172800000

# 存储与基础设施
UPLOAD_DIR=./uploads
DATABASE_URL=postgresql+psycopg://loveessay:change-me@postgres:5432/loveessay
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=loveessay-tasks

# Docker Compose 服务配置
APP_IMAGE=loveessay-app:local
HOST_PORT=8000
POSTGRES_DB=loveessay
POSTGRES_USER=loveessay
POSTGRES_PASSWORD=change-me

# LLM 模型配置（docker-compose/config.py 通过这些变量名读取）
DRAFT_MODEL_API_KEY=your-draft-model-api-key
DRAFT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DRAFT_MODEL_NAME=qwen-plus
DRAFT_STAGE_MODEL_NAME=qwen3.5-plus
POLISH_MODEL_API_KEY=your-polish-model-api-key
POLISH_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
POLISH_MODEL_NAME=your-custom-deployed-model-name

# 应用登录凭据
APP_LOGIN_USER=admin
APP_LOGIN_PASS=change-me

# LangSmith 追踪（可选，不需要可留空或删除）
LANGSMITH_PROJECT=love-essay-v2
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
